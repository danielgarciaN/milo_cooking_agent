# Copio este archivo como .env y escribo mi clave de Gemini (https://aistudio.google.com/apikey).
# El archivo .env nunca se sube a GitHub (está en .gitignore).
GOOGLE_API_KEY=

# Opcional: modelos de Gemini. Si cambio el modelo de embeddings, reconstruyo el índice con
# python scripts/build_index.py --rebuild
MILO_MODEL=gemini-3.5-flash-lite
MILO_FALLBACK_MODEL=gemini-3.1-flash-lite
MILO_EMBEDDING_MODEL=gemini-embedding-001
MILO_EMBEDDING_DIMENSION=3072
